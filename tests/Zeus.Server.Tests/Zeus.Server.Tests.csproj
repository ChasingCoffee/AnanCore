<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Default a bare `dotnet test` to SKIP the heavy opt-in DSP-modernization
         evaluation suites (Category=DspModernization, ~20 min) so local runs stay
         fast. This is the VSTestTestCaseFilter MSBuild property — the `dotnet
         test` filter argument is the CLI alias for it and REPLACES this value
         (it does NOT get ANDed, unlike a runsettings TestCaseFilter). So both CI
         workflows override it cleanly: the PR gate selects "Category!=DspModernization"
         and the scheduled dsp-modernization-tests.yml selects "Category=DspModernization". -->
    <VSTestTestCaseFilter>Category!=DspModernization</VSTestTestCaseFilter>
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OpenhpsdrZeus\OpenhpsdrZeus.csproj" />
    <ProjectReference Include="..\..\Zeus.Protocol1\Zeus.Protocol1.csproj" />
    <ProjectReference Include="..\..\Zeus.Contracts\Zeus.Contracts.csproj" />
    <ProjectReference Include="..\..\Zeus.Dsp\Zeus.Dsp.csproj" />

    <!-- Live Diagnostics API v2 — Layer 2: source generator emits one named
         xUnit test class per IDiagnosticsProvider. Analyzer reference only; its
         assembly is not part of the test project's runtime closure. -->
    <ProjectReference Include="..\..\Zeus.Diagnostics.TestGen\Zeus.Diagnostics.TestGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Recorded WSPR slots for the managed-vs-native golden test
       (WsprGoldenTests). Captured with ZEUS_WSPR_CAPTURE_DIR. -->
  <ItemGroup>
    <None Include="TestData/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


  <!-- Plugin-probe tests run the OpenhpsdrZeus host in probe mode, which loads
       the native bridges from runtimes/<rid>/native. Copy a local cmake build
       over the committed binaries so the probe exercises the fresh bridge
       (same as Zeus.Plugins.Host.Tests). -->
  <Target Name="CopyFreshPluginBridges" AfterTargets="Build">
    <PropertyGroup>
      <ZeusNativeRidDir>$(OutDir)runtimes/$(NETCoreSdkRuntimeIdentifier)/native</ZeusNativeRidDir>
    </PropertyGroup>
    <ItemGroup>
      <FreshBridge Include="$(MSBuildThisFileDirectory)..\..\native\zeus-vst-bridge\build\libzeus-vst-bridge.dylib" />
      <FreshBridge Include="$(MSBuildThisFileDirectory)..\..\native\zeus-vst-bridge\build\libzeus-vst-bridge.so" />
      <FreshBridge Include="$(MSBuildThisFileDirectory)..\..\native\zeus-vst-bridge\build\Release\zeus-vst-bridge.dll" />
      <FreshBridge Include="$(MSBuildThisFileDirectory)..\..\native\zeus-au-bridge\build\libzeus-au-bridge.dylib" />
      <FreshBridge Include="$(MSBuildThisFileDirectory)..\..\native\zeus-vst-bridge\build\zeus-plugin-probe" />
      <FreshBridge Include="$(MSBuildThisFileDirectory)..\..\native\zeus-vst-bridge\build\Release\zeus-plugin-probe.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(FreshBridge)" DestinationFolder="$(ZeusNativeRidDir)" Condition="Exists('%(FreshBridge.FullPath)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
